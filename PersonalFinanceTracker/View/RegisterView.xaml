<Window x:Class="PersonalFinanceTracker.View.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Register"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Maximized"
        mc:Ignorable="d"
        Background="#1F375D">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryDark" Color="#1F375D" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0C4C8A" />
        <SolidColorBrush x:Key="AccentLight" Color="#ADDDFE" />
        <SolidColorBrush x:Key="AccentSoft" Color="#97D5E0" />

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#F5F9FC" />
            <Setter Property="BorderBrush" Value="#97D5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="#F5F9FC" />
            <Setter Property="BorderBrush" Value="#97D5E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0C4C8A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F375D" Offset="0" />
                <GradientStop Color="#0C4C8A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="420"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16">
            <StackPanel>
                <TextBlock Text="Create Account"
                           HorizontalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F375D" />

                <TextBlock Text="Sign up to get started"
                           Margin="0,5,0,18"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#7A7A7A" />

                <TextBlock Text="First Name"
                           FontSize="12"
                           Foreground="#1F375D" />

                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Last Name"
                           FontSize="12"
                           Foreground="#1F375D" />

                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Username"
                           FontSize="12"
                           Foreground="#1F375D" />

                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Password"
                           FontSize="12"
                           Foreground="#1F375D" />

                <PasswordBox x:Name="PasswordBox" />

                <TextBlock Text="Confirm Password"
                           FontSize="12"
                           Foreground="#1F375D" />

                <PasswordBox x:Name="ConfirmPasswordBox" />

                <Button Content="Register"
                        Click="RegisterButton_Click" />

                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12">
                    <Run Text="Already have an account? " />
                    <Hyperlink Click="LoginLink_Click"
                               Cursor="Hand"
                               Foreground="#0C4C8A">
                        Login
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>