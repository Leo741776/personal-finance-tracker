<UserControl x:Class="PersonalFinanceTracker.View.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             Background="#F4F7FB">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0C4C8A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1F375D" />
            <Setter Property="Background" Value="#F4F7FB" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0C4C8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#97D5E0" />
                                <Setter Property="Foreground" Value="#1F375D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransactionGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FB" />
            <Setter Property="Foreground" Value="#1F375D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="TransactionGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1F375D" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Cash Balance"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F375D" />

                    <TextBlock Text="{Binding CashBalance, StringFormat={}{0:C}}"
                               Margin="0,8,0,0"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#0C4C8A" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quick Actions"
                                   Margin="0,0,0,16"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <Button Content="Add Cash"
                                Command="{Binding AddCashCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />

                        <Button Content="Add Transaction"
                                Command="{Binding AddTransactionCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />

                        <Button Content="Edit Budget"
                                Command="{Binding EditBudgetCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="#E6E6E6" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Cash Flow Overview"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F375D" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <RadioButton Content="7D"
                                             GroupName="CashFlowRange"
                                             IsChecked="True"
                                             Command="{Binding ShowCashFlow7DaysCommand}"
                                             Style="{StaticResource RangeToggleStyle}" />

                                <RadioButton Content="30D"
                                             GroupName="CashFlowRange"
                                             Command="{Binding ShowCashFlow30DaysCommand}"
                                             Style="{StaticResource RangeToggleStyle}" />

                                <RadioButton Content="1Y"
                                             GroupName="CashFlowRange"
                                             Command="{Binding ShowCashFlow1YearCommand}"
                                             Style="{StaticResource RangeToggleStyle}" />
                            </StackPanel>
                        </Grid>

                        <lvc:CartesianChart Grid.Row="2"
                                            LegendPosition="Bottom"
                                            Series="{Binding CashFlowSeries}"
                                            TooltipPosition="Top"
                                            XAxes="{Binding CashFlowXAxes}"
                                            YAxes="{Binding CashFlowYAxes}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Net Cash Change"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F375D" />

                    <lvc:CartesianChart Grid.Row="2"
                                        LegendPosition="Bottom"
                                        Series="{Binding NetCashChangeSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding NetCashChangeXAxes}"
                                        YAxes="{Binding NetCashChangeYAxes}" />
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Monthly Budget"
                                   Margin="0,0,0,18"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Budget"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#7A7A7A" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding MonthlyBudgetLimit, StringFormat={}{0:C}}"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F375D" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Amount Spent"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#7A7A7A" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding AmountSpentThisMonth, StringFormat={}{0:C}}"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F375D" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Status"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#7A7A7A" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding MonthlyBudgetStatus}"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Transaction History"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding CurrentMonthTransactions}"
                                  MinHeight="260"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#F4F7FB"
                                  ColumnHeaderStyle="{StaticResource TransactionGridHeaderStyle}"
                                  CellStyle="{StaticResource TransactionGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding Date, StringFormat={}{0:MM/dd/yyyy}}"
                                                    SortMemberPath="Date"
                                                    Width="*" />

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding MerchantOrSource}"
                                                    SortMemberPath="MerchantOrSource"
                                                    Width="2*" />

                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    SortMemberPath="Category"
                                                    Width="2*" />

                                <DataGridTextColumn Header="Amount"
                                                    Binding="{Binding Amount, StringFormat={}{0:C}}"
                                                    SortMemberPath="Amount"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>