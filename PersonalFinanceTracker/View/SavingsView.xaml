<UserControl x:Class="PersonalFinanceTracker.View.SavingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             Background="#F4F7FB">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0C4C8A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1F375D" />
            <Setter Property="Background" Value="#F4F7FB" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0C4C8A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#97D5E0" />
                                <Setter Property="Foreground" Value="#1F375D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Savings Balance"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <TextBlock Text="{Binding TotalSavingsBalance, StringFormat={}{0:C}}"
                                   Margin="0,8,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#0C4C8A" />

                        <TextBlock Text="Current balance across all savings accounts"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#7A7A7A" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Deposit"
                            VerticalAlignment="Center"
                            Command="{Binding DepositCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current APY"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <TextBlock Text="{Binding CurrentApy, StringFormat={}{0:F2}%}"
                                   Margin="0,8,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#0C4C8A" />

                        <TextBlock Text="Annual percentage yield for savings"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="#7A7A7A" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Edit"
                            VerticalAlignment="Center"
                            Command="{Binding EditApyCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Savings Balance Over Time"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F375D" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <RadioButton Content="90D"
                                         GroupName="SavingsBalanceRange"
                                         IsChecked="True"
                                         Command="{Binding ShowSavingsBalance90DaysCommand}"
                                         Style="{StaticResource RangeToggleStyle}" />

                            <RadioButton Content="1Y"
                                         GroupName="SavingsBalanceRange"
                                         Command="{Binding ShowSavingsBalance1YearCommand}"
                                         Style="{StaticResource RangeToggleStyle}" />

                            <RadioButton Content="Lifetime"
                                         GroupName="SavingsBalanceRange"
                                         Command="{Binding ShowSavingsBalanceLifetimeCommand}"
                                         Style="{StaticResource RangeToggleStyle}" />
                        </StackPanel>
                    </Grid>

                    <lvc:CartesianChart Grid.Row="2"
                                        LegendPosition="Bottom"
                                        Series="{Binding SavingsBalanceSeries}"
                                        TooltipPosition="Top"
                                        XAxes="{Binding SavingsBalanceXAxes}"
                                        YAxes="{Binding SavingsBalanceYAxes}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>